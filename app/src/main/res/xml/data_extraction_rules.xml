<?xml version="1.0" encoding="utf-8"?>
<!--
    Auto Backup and device-to-device transfer on Android 12 and later. Only the game's progress
    and settings go, as in backup_rules.xml. The last state lookup in place.xml stays on the phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="game.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="game.xml" />
    </device-transfer>
</data-extraction-rules>
